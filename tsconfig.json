{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-client-ui-primitives": ["./node_modules/@deepseek-ai-runtime/dsh-client-ui-primitives.d.ts"]
    }
  },
  "include": ["src/host/**/*.ts", "src/shared/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["src/client", "node_modules"]
}
