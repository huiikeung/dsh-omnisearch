{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "outDir": "lib",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@deepseek-ai/dsh-client-ui-primitives": ["./node_modules/@deepseek-ai-runtime/dsh-client-ui-primitives.d.ts"]
    }
  },
  "include": ["src/host/**/*.ts", "src/client/**/*.ts", "src/client/**/*.tsx", "src/shared/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["src/**/*.test.ts", "routes.smoke.mjs"]
}
